{
  "name": "comark",
  "version": "0.6.2",
  "description": "The Markdown engine for the modern web. Parse Markdown with components, attributes and plugins to a compact AST, at build time or runtime, and render with Vue, React, Svelte, Angular, HTML or ANSI. Streaming-ready for AI output.",
  "keywords": [
    "ai",
    "angular",
    "ast",
    "commonmark",
    "components",
    "gfm",
    "markdown",
    "markdown-it",
    "mdc",
    "mdx",
    "parser",
    "react",
    "streaming",
    "svelte",
    "vue"
  ],
  "homepage": "https://comark.dev",
  "bugs": {
    "url": "https://github.com/comarkdown/comark/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comarkdown/comark.git"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./plugins/*": "./dist/plugins/*.js",
    "./utils": "./dist/utils/index.js",
    "./utils/trace": "./dist/utils/trace.js",
    "./parse": "./dist/parse.js",
    "./render": "./dist/render.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "entities": "^8.0.0",
    "htmlparser2": "^12.0.0",
    "js-yaml": "^5.2.1",
    "markdown-exit": "1.1.0-beta.2"
  },
  "devDependencies": {
    "@json-render/core": "^0.19.0",
    "@shikijs/twoslash": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "minimark": "0.2.0",
    "rangi": "^2.2.0",
    "tsx": "^4.23.0",
    "twoslash": "^0.3.9",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.17.0",
    "rangi": "^2.2.0",
    "shiki": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "beautiful-mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "rangi": {
      "optional": true
    }
  },
  "scripts": {
    "stub": "node ../../scripts/stub.mjs",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  }
}