const videoId = computed(() => `vimeo-embed:${id.value}`);
const { data: payload } = useAsyncData(
  videoId,
  // TODO ideally we cache this
  () => $fetch(`https://vimeo.com/api/oembed.json`, {
    params: {
      url: `https://vimeo.com/${id.value}`,
      format: "json"
