export const isActualBanTimestampExpired = (bannedUntilRaw) => {
  if (bannedUntilRaw === null || bannedUntilRaw === void 0) {
    return true;
  }
  const numericTimestamp = Number(bannedUntilRaw);
  if (Number.isNaN(numericTimestamp)) {
    return true;
  }
  return Date.now() >= numericTimestamp;
};
